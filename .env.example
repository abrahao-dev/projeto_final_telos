# Porta HTTP do servidor (default 5000)
PORT=5000

# String de conexão MongoDB Atlas
# Atlas: Cluster → Connect → Drivers → copiar URI e substituir <user>/<password>
# Local (alternativa): mongodb://localhost:27017/inovapcd
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inovapcd?retryWrites=true&w=majority

# Chave secreta para assinar tokens JWT
# Gere com: openssl rand -base64 32
JWT_SECRET=troque-isso-por-uma-string-longa-e-aleatoria
